  "settings": [
    {
      "id": "explorer.showHidden",
      "category": "Explorer",
      "name": "Show hidden files",
      "description": "Show files and folders marked as hidden in File Explorer.",
      "hive": "HKCU",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "valueName": "Hidden",
      "valueType": "DWord",
      "labels": { "1": "Enabled (show)", "2": "Disabled (hide)" },
      "recommended": 1,
      "microsoftDefault": 2,
      "risk": "Low",
      "requiresRestart": false,
      "requiresLogoff": false,
      "requiresExplorerRestart": true,
      "requiresAdmin": false
    },
    {
